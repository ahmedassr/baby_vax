rules_version = '2';

// Baby Vax Firestore security rules.
//
// Model: one Firebase Auth user == one child profile.
//   users/{userId}                      - the child's profile
//   users/{userId}/medical_dates/{id}   - that child's vaccination schedule
//   users/{userId}/measurements/{id}    - dated growth measurements (v1.1)
//   users/{userId}/reminders/{id}       - the parent's own reminders (v1.1)
//   tips/{id}, tips_en/{id}             - app content, read-only for clients
//
// Default is deny: the final catch-all rejects every path not named here, so a
// collection added later is closed until its rules are written.
//
// There are no Cloud Functions in this project (the app is on the Spark plan),
// so nothing writes with admin privileges. Every write comes from the signed-in
// owner and is validated here.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // The only authorization rule that matters: a user may touch their own
    // document subtree and nothing else.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // Guards against a client writing an unbounded blob into any string field.
    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isOptionalShortString(data, field, maxLen) {
      return !data.keys().hasAny([field]) ||
             data[field] == null ||
             isShortString(data[field], maxLen);
    }

    // Absent, null, or a timestamp.
    function isOptionalTimestamp(data, field) {
      return !data.keys().hasAny([field]) ||
             data[field] == null ||
             data[field] is timestamp;
    }

    // Absent, null, or a number in [min, max].
    function isOptionalNumberIn(data, field, min, max) {
      return !data.keys().hasAny([field]) ||
             data[field] == null ||
             (data[field] is number && data[field] >= min && data[field] <= max);
    }

    // Absent, null, or one of [values].
    function isOptionalOneOf(data, field, values) {
      return !data.keys().hasAny([field]) ||
             data[field] == null ||
             data[field] in values;
    }

    // ---- users ------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasOnly([
               'uid', 'email', 'birthday', 'name',
               'height', 'weight', 'bloodPercentage', 'headSize',
               // v1.1, optional: the baby's sex, for the WHO growth charts.
               // A v1.0 profile without it is still valid.
               'sex'
             ])
             // uid must match the document id, so a profile cannot claim to be
             // someone else's.
             && data.uid == request.auth.uid
             && isShortString(data.email, 320)
             && isOptionalShortString(data, 'birthday', 40)
             && isOptionalShortString(data, 'name', 100)
             && isOptionalShortString(data, 'height', 20)
             && isOptionalShortString(data, 'weight', 20)
             && isOptionalShortString(data, 'bloodPercentage', 20)
             && isOptionalShortString(data, 'headSize', 20)
             && isOptionalOneOf(data, 'sex', ['female', 'male']);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      // Needed by the in-app delete-account flow.
      allow delete: if isOwner(userId);

      // ---- medical_dates (the vaccination schedule) ----------------------

      function isValidMedicalDate(data) {
        return data.keys().hasOnly([
                 'name', 'description', 'date', 'state', 'code',
                 // v1.1, optional: what was recorded when the dose was
                 // given. A v1.0 dose without them is still valid.
                 'givenDate', 'clinic', 'lot', 'note'
               ])
               && data.keys().hasAll(['name', 'date', 'state'])
               && isShortString(data.name, 200)
               && isOptionalShortString(data, 'description', 1000)
               && isOptionalShortString(data, 'code', 60)
               && data.date is timestamp
               // Only the three states the app understands. Anything else
               // would make the schedule screen and the reminder sync behave
               // unpredictably.
               && data.state in ['Pending', 'Completed', 'Skipped']
               && isOptionalTimestamp(data, 'givenDate')
               && isOptionalShortString(data, 'clinic', 120)
               && isOptionalShortString(data, 'lot', 60)
               && isOptionalShortString(data, 'note', 500);
               // Not enforced: "a record only on a Completed dose". v1.1
               // removes the record when undoing, but a v1.0 build still on
               // someone's phone writes only { state }, and that must not be
               // rejected.
      }

      match /medical_dates/{medicalDateId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && isValidMedicalDate(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // ---- measurements (v1.1 growth tracker) -----------------------------
    //
    // users/{userId}/measurements/{id}: one dated set of measurements.
    // Bounds are wide plausibility checks (the schedule covers ages up to
    // 18); they catch a weight typed in grams, not unusual children.

    function isValidMeasurement(data) {
      return data.keys().hasOnly(['date', 'weightKg', 'heightCm', 'headCm', 'note'])
             && data.keys().hasAll(['date'])
             && data.date is timestamp
             && isOptionalNumberIn(data, 'weightKg', 0.3, 150)
             && isOptionalNumberIn(data, 'heightCm', 20, 220)
             && isOptionalNumberIn(data, 'headCm', 20, 70)
             && isOptionalShortString(data, 'note', 500)
             // At least one value: an empty measurement means nothing.
             && (data.get('weightKg', null) != null
                 || data.get('heightCm', null) != null
                 || data.get('headCm', null) != null);
    }

    match /users/{userId}/measurements/{measurementId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && isValidMeasurement(incoming());
      allow delete: if isOwner(userId);
    }

    // ---- reminders (v1.1 custom reminders and appointments) -------------
    //
    // users/{userId}/reminders/{id}: scheduled on the device only; the
    // document is the source the phone rebuilds its notifications from.

    function isValidReminder(data) {
      return data.keys().hasOnly(['title', 'note', 'dateTime', 'repeat', 'enabled'])
             && data.keys().hasAll(['title', 'dateTime', 'repeat', 'enabled'])
             && isShortString(data.title, 100)
             && data.title.size() > 0
             && isOptionalShortString(data, 'note', 500)
             && data.dateTime is timestamp
             && data.repeat in ['none', 'daily', 'weekly', 'monthly']
             && data.enabled is bool;
    }

    match /users/{userId}/reminders/{reminderId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && isValidReminder(incoming());
      allow delete: if isOwner(userId);
    }

    // ---- app content ------------------------------------------------------

    // Tips are authored by Ahmed in the console. Clients read them; nothing in
    // the app writes them, so writes are closed to everyone.
    match /tips/{tipId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    match /tips_en/{tipId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    // ---- default deny -----------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
